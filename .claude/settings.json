{
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./.venv/**)",
      "Read(./coverage/**)",
      "Read(./**/*.log)",
      "Read(./**/*.min.js)",
      "Read(./**/*.lock)",
      "Read(./package-lock.json)",
      "Read(./**/*.map)",
      "Read(./**/*.min.css)",
      "Read(./**/*.bundle.js)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.csv)",
      "Read(./.next/**)",
      "Read(./out/**)",
      "Read(./target/**)",
      "Read(./**/__pycache__/**)",
      "Read(./yarn.lock)",
      "Read(./pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_summary.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_large_read.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/trim_output.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
